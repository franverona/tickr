# Defaults to "sqlite" if unset — no config needed for the common case.
# DB_TYPE=postgres
# DB_TYPE=mysql
# DB_TYPE=firestore

# Required when DB_TYPE=postgres. Matches docker-compose.yml's postgres service.
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/tickr

# Required when DB_TYPE=mysql. Matches docker-compose.yml's mysql service.
# DATABASE_URL=mysql://root:mysql@localhost:3306/tickr

# Required when DB_TYPE=firestore. Paste the full service-account JSON (Firebase Console →
# Project Settings → Service Accounts → Generate new private key) as a single-line string —
# NOT the Web SDK config (apiKey/authDomain/appId) from your app's firebaseConfig. This connects
# to the real remote project, even in dev — use the emulator below to avoid that.
# FIRESTORE_SERVICE_ACCOUNT_KEY={"type":"service_account","project_id":"...","private_key":"...","client_email":"...",...}

# DB_TYPE=firestore against the local emulator instead (docker compose up -d firestore).
# No service-account key needed; when set, nothing reaches the live project.
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080

# Tests only (pnpm test), never the app: the cross-backend tests WIPE every task
# and tag in these databases. Default to a tickr_test database on docker-compose.yml's
# services, created on demand. Vitest doesn't read this file for them: export them in
# the shell, and only to point the tests at another throwaway database.
# POSTGRES_TEST_URL=postgresql://postgres:postgres@localhost:5432/tickr_test
# MYSQL_TEST_URL=mysql://root:mysql@localhost:3306/tickr_test
# FIRESTORE_TEST_HOST=localhost:8080   (emulator only, never a live project)
