# Defaults to "sqlite" if unset — no config needed for the common case.
# DB_TYPE=postgres
# DB_TYPE=mysql
# DB_TYPE=firestore

# Required when DB_TYPE=postgres. Matches docker-compose.yml's postgres service.
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/tickr

# Required when DB_TYPE=mysql. Matches docker-compose.yml's mysql service.
# DATABASE_URL=mysql://root:mysql@localhost:3306/tickr

# Required when DB_TYPE=firestore. Paste the full service-account JSON (Firebase Console →
# Project Settings → Service Accounts → Generate new private key) as a single-line string —
# NOT the Web SDK config (apiKey/authDomain/appId) from your app's firebaseConfig. There is no
# local/emulator mode — this always connects to the real remote project, even in dev.
# FIRESTORE_SERVICE_ACCOUNT_KEY={"type":"service_account","project_id":"...","private_key":"...","client_email":"...",...}

# Tests only (pnpm test), never the app: the cross-backend tests WIPE every task
# and tag in these databases. Default to docker-compose.yml's services; set them
# only to point the tests at another throwaway database.
# POSTGRES_TEST_URL=postgresql://postgres:postgres@localhost:5432/tickr
# MYSQL_TEST_URL=mysql://root:mysql@localhost:3306/tickr
